{
  "services": {
    "gemini-tiyan": {
      "framework": "express",
      "entrypoint": "server.js",
      "root": ".",
      "buildCommand": "npm install"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "type": "service",
        "service": "gemini-tiyan"
      }
    }
  ]
}
