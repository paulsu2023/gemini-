# 复制为 .env 后按需修改（.env 不会被提交到 Git）

# 端口
PORT=3000

# 访问密码：部署给朋友时务必设置，留空则不需要密码
ACCESS_PASSWORD=

# 凭据二选一：
# 1) 本地：服务账号 JSON 文件路径（默认 credentials/service-account.json，优先于系统 GOOGLE_APPLICATION_CREDENTIALS）
# CREDENTIALS_FILE=credentials/service-account.json
# 2) 线上：把整个 JSON 内容（或其 base64）放进环境变量
# GOOGLE_CREDENTIALS_JSON=

# 可选：覆盖项目 ID（默认读取凭据里的 project_id）
# GCP_PROJECT=
# 视频模型默认区域
# VERTEX_REGION=us-central1
